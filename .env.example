# Copy to .env and fill in. If DB_NAME is not set, the app uses SQLite.
DB_NAME=library_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Google OAuth credentials (create a Web application OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
